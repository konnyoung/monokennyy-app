{
  "name": "kplayer-electron",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Kennyy",
  "description": "monokennyy desktop player",
  "kplayer": {
    "discordRpcClientId": "1500636501099286640",
    "discordRpcActivityName": "monokennyy",
    "discordRpcAssets": {
      "largeImageKey": "monochrome",
      "playSmallImageKey": "play",
      "playSmallImageText": "Playing",
      "pauseSmallImageKey": "pause",
      "pauseSmallImageText": "Paused",
      "idleSmallImageKey": "idle",
      "idleSmallImageText": "Idle"
    },
    "discordRpcButtons": []
  },
  "scripts": {
    "dev:web": "vite",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 && electron .",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build:icons": "node scripts/build-icons.cjs",
    "build:discord-assets": "node scripts/build-discord-assets.cjs",
    "build:web": "tsc --noEmit && vite build",
    "build": "npm run build:icons && npm run build:web && electron-builder --win nsis",
    "build:dir": "npm run build:icons && npm run build:web && electron-builder --win nsis --dir",
    "preview": "vite preview"
  },
  "dependencies": {
    "@uimaxbai/am-lyrics": "^1.3.0",
    "cheerio": "^1.2.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.511.0",
    "pocketbase": "^0.26.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "concurrently": "^9.1.2",
    "electron": "^36.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.kennyy.monokennyy",
    "productName": "monokennyy",
    "copyright": "Copyright © 2026 Kennyy",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "monokennyy",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Audio",
      "target": [
        "AppImage"
      ]
    }
  }
}
